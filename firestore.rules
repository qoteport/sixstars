
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check ownership by UID
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Helper function to check if the user is an admin
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Helper function to check if the user is the owner of a given product
    function isProductOwner(productId) {
      let product = get(/databases/$(database)/documents/softwareProducts/$(productId)).data;
      let userProfile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return request.auth != null && product.partnerId == userProfile.partnerId;
    }

    // --- PUBLIC-READABLE COLLECTIONS ---

    // Software products are public to read.
    match /softwareProducts/{productId} {
      allow read: if true;

      // Admins or the partner who owns the product can create/update.
      allow write: if isAdmin() || isProductOwner(productId);

      // Reviews can be created by any authenticated user.
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if request.auth != null;
        // For now, prevent updates/deletes to keep it simple.
        allow update, delete: if false;
      }

      // Pricing tiers are managed by admins or the product owner.
      match /pricingTiers/{tierId} {
        allow read: if true;
        allow write: if isAdmin() || isProductOwner(productId);
      }
    }

    // Software categories are public to read
    match /softwareCategories/{categoryId} {
        allow read: if true;
        // Only Admins can manage categories
        allow write: if isAdmin();
    }

    // Partners list is public to read.
    match /partners/{partnerId} {
      allow read: if true;
      // Only admins can create, update, or delete partners.
      allow write: if isAdmin();
    }

    // Approved testimonials are public to read.
    match /testimonials/{testimonialId} {
      allow read: if true;
      // Only admins manage testimonials.
      allow write: if isAdmin();
    }


    // --- PROTECTED COLLECTIONS ---

    // User profiles can be read by anyone.
    match /users/{userId} {
      allow read: if true;
      // Users can create their own profile during onboarding.
      allow create: if isOwner(userId);
      // Admins can update any profile. Users can update their own profile,
      // but they are NOT allowed to change their own `isAdmin` status.
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.isAdmin == resource.data.isAdmin);
       // Only admins can delete user profiles.
      allow delete: if isAdmin();
    }

    // Inquiries are admin-only after creation.
    match /inquiries/{inquiryId} {
      allow create: if true; // Public contact form
      allow read, update, delete: if isAdmin();
    }

    match /salesInquiries/{inquiryId} {
      allow create: if true; // Public contact form
      allow read, update, delete: if isAdmin();
    }

    // Customers and their interactions are admin-only.
    match /customers/{customerId} {
      allow read, write: if isAdmin();

      match /interactions/{interactionId} {
         allow read, write: if isAdmin();
      }
    }
  }
}
