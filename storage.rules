rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read on software images
    match /software-images/{allPaths=**} {
      allow read: if true;
      // Allow admins to write
      allow write: if request.auth != null && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
  }
}

    